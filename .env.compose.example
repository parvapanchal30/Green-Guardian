# Copy to .env.compose (gitignored) and fill in. Names only here; never commit real values.
# POSTGRES_PASSWORD: the password of the container database (any strong string; letters and digits avoid URL-encoding issues)
POSTGRES_PASSWORD=
# JWT_SECRET: 32+ characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional
APP_ENV=development
WEATHER_PROVIDER=open_meteo
WEB_PORT=8080
BACKEND_PORT=8000
