# Copy to backend/.env (gitignored). NAMES ONLY here — never commit real values.
ENV=development
LOG_LEVEL=INFO

# Hosted PostgreSQL + PostGIS (Supabase session-pooler string recommended for dev; see docs/DATABASE_SETUP.md)
# Paste the provider string and REMOVE the [brackets] around the password (they are only a placeholder marker).
DATABASE_URL=
# session (default) | transaction (only if you must use the provider's port-6543 pooler)
DB_POOL_MODE=session
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_S=10
POSTGIS_SCHEMA=extensions
# For tests that need real PostGIS. May equal DATABASE_URL: those tests only use a throwaway schema they drop afterwards.
TEST_DATABASE_URL=

# >= 32 random characters in production (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=["http://localhost:5173"]

# Weather: open_meteo (default) | mock (dev/test only; refused when ENV=production)
WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_S=8
WEATHER_CACHE_TTL_S=900
