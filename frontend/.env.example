# Frontend build-time variables (names only; copy to .env.local for local work, set in the Vercel project for hosting).
# EVERYTHING prefixed VITE_ IS COPIED INTO THE PUBLIC BROWSER BUNDLE. Never put a secret here.
#
# Absolute https URL of the API, for hosted builds (the build FAILS if it is missing, local or not https).
# Leave unset locally: the dev server proxies /api to VITE_DEV_API_TARGET (default http://localhost:8000).
VITE_API_BASE_URL=
# Optional map tile URL template (default: the public OpenStreetMap server, light use only).
VITE_MAP_TILE_URL=
# Dev server only: where /api is proxied.
VITE_DEV_API_TARGET=
